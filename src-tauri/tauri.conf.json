{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuellDock",
  "version": "0.1.0",
  "identifier": "dev.quelldock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuellDock",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Manage Linux apps and packages",
    "longDescription": "A unified AppImage, Flatpak, AUR, and native package manager.",
    "icon": ["icons/icon.png"]
  }
}
